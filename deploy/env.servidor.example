# Copia a /opt/apps/trama/.env en el Servidor 1 (no se versiona). Rutas del CONTENEDOR.
TRAMA_AUTH_MODE=password
TRAMA_PASSWORD_HASH=          # python -m trama set-password (en el PC) y pegar aquí
TRAMA_COOKIE_SECURE=1
TRAMA_ALLOWED_ROOTS=          # vacío: los packs vienen de Google Drive
TRAMA_WORKERS=2
TRAMA_EXTRACT_CONCURRENCY=1
TRAMA_CACHE_MAX_GB=5
TRAMA_MIN_FREE_GB=15
TRAMA_DRIVE_CLIENT_FILE=/data/drive/client_secret.json
TRAMA_DRIVE_REDIRECT_URI=https://trama.jrgblanco.com/api/drive/auth/callback
TRAMA_BACKUP_KEEP=5
