# Copia este archivo a .env (no se versiona) y ajusta las rutas.
# Raíces locales que TRAMA puede explorar e incorporar, separadas por ';'.
TRAMA_ALLOWED_ROOTS=C:\ruta\a\muestras;D:\otra\carpeta
# Carpeta de datos de ejecución (catálogo SQLite y derivados). Debe quedar FUERA de OneDrive/Drive.
# Por defecto: %LOCALAPPDATA%\TRAMA en Windows, ~/.local/share/trama en Linux/macOS.
#TRAMA_DATA_DIR=C:\Users\usuario\AppData\Local\TRAMA
TRAMA_HOST=127.0.0.1
TRAMA_PORT=8765
# Hilos del worker multimedia (análisis y derivados).
TRAMA_WORKERS=2
# FFmpeg/ffprobe: si están vacíos se usa el PATH y, en su defecto, los binarios del paquete static-ffmpeg.
#TRAMA_FFMPEG=
#TRAMA_FFPROBE=
# Packs ZIP (E2): tamaño máximo de la caché de extracción y espacio libre que nunca se invade, en GB.
TRAMA_CACHE_MAX_GB=30
TRAMA_MIN_FREE_GB=10
# Extracciones simultáneas (1 recomendado en disco mecánico).
TRAMA_EXTRACT_CONCURRENCY=1
